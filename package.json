{
  "name": "quizz-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev -p 3000",
    "predev:backend": "npm run football:ensure",
    "dev:backend": "tsx watch server/index.ts",
    "prebuild": "npm run football:ensure",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "pretest": "npm run football:ensure",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project node tests/unit",
    "test:integration": "vitest run --project node tests/integration",
    "test:client": "vitest run --project dom",
    "test:coverage": "vitest run --coverage",
    "start": "next start",
    "start:backend": "tsx server/index.ts",
    "start:prod": "node dist/server/production.js",
    "lint": "next lint",
    "seed:questions": "tsx scripts/seed-questions.ts",
    "build:countries": "tsx scripts/build-countries.ts",
    "football:build": "tsx scripts/build-football-db.ts",
    "football:sync-open": "tsx scripts/sync-open-football-data.ts",
    "football:ensure": "tsx scripts/football-db-artifact.ts ensure",
    "football:pack": "tsx scripts/football-db-artifact.ts pack",
    "football:refresh": "npm run football:build && npm run football:sync-open && npm run football:check && npm run football:pack",
    "football:sync-api": "tsx scripts/sync-football-api.ts",
    "football:check": "tsx scripts/check-football-db.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.7",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "express": "^4.18.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "nanoid": "^5.0.5",
    "next": "^14.2.0",
    "puppeteer": "^24.37.3",
    "react": "^18.2.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.7"
  }
}
